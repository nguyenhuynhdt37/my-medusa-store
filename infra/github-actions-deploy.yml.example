name: Deploy production to EC2

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

concurrency:
  group: production
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production

    steps:
      - name: Configure AWS credentials with GitHub OIDC
        uses: aws-actions/configure-aws-credentials@v5
        with:
          role-to-assume: ${{ secrets.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}

      - name: Deploy through SSM
        id: deploy
        env:
          INSTANCE_ID: ${{ vars.EC2_INSTANCE_ID }}
          REPOSITORY: ${{ github.repository }}
          REVISION: ${{ github.sha }}
        run: |
          set -euo pipefail

          command_id=$(aws ssm send-command \
            --instance-ids "$INSTANCE_ID" \
            --document-name AWS-RunShellScript \
            --comment "Deploy $REVISION" \
            --parameters commands="[
              \"set -euo pipefail\",
              \"APP_DIR=/opt/ecomoi-chatbot/app\",
              \"if [ ! -d \\\"\\$APP_DIR/.git\\\" ]; then git clone https://github.com/$REPOSITORY.git \\\"\\$APP_DIR\\\"; fi\",
              \"cd \\\"\\$APP_DIR\\\"\",
              \"git fetch --prune origin\",
              \"git checkout --detach $REVISION\",
              \"test -f .env.production\",
              \"docker compose --env-file .env.production build\",
              \"docker compose --env-file .env.production run --rm backend pnpm exec medusa db:migrate\",
              \"docker compose --env-file .env.production up -d --remove-orphans\",
              \"docker compose --env-file .env.production ps\",
              \"docker image prune -f\"
            ]" \
            --query Command.CommandId \
            --output text)

          echo "command_id=$command_id" >> "$GITHUB_OUTPUT"
          aws ssm wait command-executed \
            --command-id "$command_id" \
            --instance-id "$INSTANCE_ID"

      - name: Print deployment output
        env:
          INSTANCE_ID: ${{ vars.EC2_INSTANCE_ID }}
          COMMAND_ID: ${{ steps.deploy.outputs.command_id }}
        run: |
          aws ssm get-command-invocation \
            --command-id "$COMMAND_ID" \
            --instance-id "$INSTANCE_ID" \
            --query '{Status:Status,Output:StandardOutputContent,Error:StandardErrorContent}'
