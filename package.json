{
  "name": "my-medusa-store",
  "private": false,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "chat:test-flow": "node scripts/test-chat-message-flow.mjs",
    "chat:test-ai-first": "node scripts/test-ai-first-chat-flow.mjs"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@dtc/storefront>react": "19.0.5",
      "@dtc/storefront>react-dom": "19.0.5",
      "next>react": "19.0.5",
      "next>react-dom": "19.0.5",
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5"
    },
    "onlyBuiltDependencies": [
      "@medusajs/telemetry",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  },
  "workspaces": [
    "apps/**",
    "!apps/backend/.medusa/**"
  ],
  "overrides": {
    "ajv": "^8.0.0"
  }
}
