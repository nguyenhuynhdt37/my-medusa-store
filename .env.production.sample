# Production environment sample

NODE_ENV=production
ENVIRONMENT=production
DISABLE_MEDUSA_ADMIN=false

# docker-compose.prod.yml derives public URLs from these values.
PUBLIC_HOST=YOUR_SERVER_IP_OR_DOMAIN
PUBLIC_PROTOCOL=http
PUBLIC_CHAT_WS_PROTOCOL=ws
PUBLIC_STOREFRONT_ORIGIN=
PUBLIC_BACKEND_ORIGIN=
PUBLIC_CHAT_WS_ORIGIN=

# Database/cache
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/CHANGE_ME
REDIS_URL=redis://redis:6379

# Medusa
JWT_SECRET=
COOKIE_SECRET=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_MFA_ENCRYPTION_KEY=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
MEDUSA_PUBLISHABLE_API_KEY=
NEXT_PUBLIC_DEFAULT_REGION=vn

# Chatbot
MEDUSA_REGION_COUNTRY_CODE=vn
MEDUSA_TIMEOUT_SECONDS=8
STOREFRONT_COUNTRY_CODE=vn

# Gemini/AWS Lex
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=10
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
CHATBOT_TRACE_ENABLED=false
CHATBOT_TRACE_MAX_STRING_CHARS=4000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=
LEX_LOCALE_ID=en_US

# Facebook Messenger
FB_VERIFY_TOKEN=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_GRAPH_VERSION=v20.0

# Handover/dedupe
ENABLE_HUMAN_HANDOVER=true
ENABLE_CUSTOMER_RESUME_BOT=true
HUMAN_HANDOVER_CONFIDENCE_THRESHOLD=0.65
HUMAN_HANDOVER_TTL_SECONDS=86400
WEBHOOK_DEDUPE_TTL_SECONDS=86400

# AI usage cost tracking
AI_COST_TRACKING_ENABLED=true
AI_USAGE_SNAPSHOT_JOB_ENABLED=true
AI_USAGE_SNAPSHOT_INTERVAL_SECONDS=3600
LEX_TEXT_REQUEST_PRICE_USD=0.00075
GEMINI_INPUT_PRICE_PER_1M_TOKENS_USD=0.30
GEMINI_OUTPUT_PRICE_PER_1M_TOKENS_USD=2.50
LAMBDA_MEMORY_SIZE_MB=128
LAMBDA_REQUEST_PRICE_PER_1M_USD=0.20
LAMBDA_DURATION_PRICE_PER_GB_SECOND_USD=0.0000166667
