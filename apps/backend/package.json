{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "clean:admin-cache": "rm -rf .medusa/client .medusa/server .medusa/admin",
    "clean:vite": "rm -rf node_modules/.vite",
    "build": "pnpm run clean:admin-cache && medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "dev:realtime": "ts-node src/realtime/server.ts",
    "dev:clean": "pnpm run clean:vite && pnpm run clean:admin-cache && medusa develop",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "seed:context": "medusa exec ./src/migration-scripts/enrich-demo-data.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.15.3",
    "@medusajs/admin-shared": "2.15.3",
    "@medusajs/caching": "2.15.3",
    "@medusajs/cli": "2.15.3",
    "@medusajs/dashboard": "2.15.3",
    "@medusajs/draft-order": "2.15.3",
    "@medusajs/framework": "2.15.3",
    "@medusajs/medusa": "2.15.3",
    "@medusajs/ui": "4.1.13",
    "@mikro-orm/core": "6.6.12",
    "@mikro-orm/knex": "6.6.12",
    "@mikro-orm/migrations": "6.6.12",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "6.30.3",
    "ws": "^8.21.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.15.3",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2"
}
